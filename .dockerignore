# Keep the build context small and prevent local state from leaking into images.
.git
.github
.venv
var
var-test
reports
test-runs
validation-final
node_modules
backend/static
.tools
__pycache__
*.pyc
.pytest_cache
docs/media
jira

# Секреты и локальное состояние не должны попадать в образ.
.env
*.pem
*.key
security-reports

# Вложенные каталоги: паттерн без слэша матчится только от корня
# контекста, поэтому frontend/node_modules под `node_modules` не подпадал.
**/node_modules
**/__pycache__
**/.pytest_cache

# Любой .env*, а не только голый .env: frontend/.env.development
# проходил мимо и уезжал в образ.
**/.env
**/.env.*
frontend/.env*

# Локальное состояние, которое не должно уезжать в образ.
cookies.txt
**/secret.key
**/*.pem
**/*.key
*.bundle

