# Keep the build context small and prevent local state from leaking into images.
.git
.github
.venv
var
var-test
reports
test-runs
validation-final
node_modules
backend/static
.tools
__pycache__
*.pyc
.pytest_cache
docs/media
jira

# Секреты и локальное состояние не должны попадать в образ.
.env
*.pem
*.key
security-reports

# Вложенные каталоги: паттерн без слэша матчится только от корня
# контекста, поэтому frontend/node_modules под `node_modules` не подпадал.
**/node_modules
**/.pytest_cache

# Кеш байткода. Правило переписано после перевода сборки на kaniko:
# `**/__pycache__` у kaniko НЕ исключает каталог глубже второго уровня —
# проверено на макете (backend/cybra/__pycache__ проходил в образ), и
# подтверждено на реальном образе: в слое лежал app/backend/cybra/__pycache__
# с файлами cpython-310, то есть кеш локального интерпретатора разработчика.
# Docker такие каталоги отсекал, kaniko — нет; без правки переход на kaniko
# молча утащил бы в поставку чужие .pyc.
#
# `**/*.pyc` убирает файлы, `**/__pycache__/**` — их содержимое; вместе они
# дают пустой каталог, а пара к первому правилу убирает и его.
**/__pycache__
**/__pycache__/**
**/*.pyc

# Любой .env*, а не только голый .env: frontend/.env.development
# проходил мимо и уезжал в образ.
**/.env
**/.env.*
frontend/.env*

# Локальное состояние, которое не должно уезжать в образ.
cookies.txt
**/secret.key
**/*.pem
**/*.key
*.bundle

