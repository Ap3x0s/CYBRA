# Переменные входа через OpenID Connect для локального стенда.
#
# Все значения — для тестового Keycloak из infra/keycloak/compose.yaml.
# В развёртывании заказчика адрес и client_secret приходят из защищённых
# переменных, а не из файла в репозитории.

# Адрес realm. Приложение ходит сюда за discovery, JWKS и токенами.
CYBRA_OIDC_ISSUER=http://localhost:8080/realms/cybra

# Идентификатор клиента в Keycloak.
CYBRA_OIDC_CLIENT_ID=cybra

# Секрет клиента. Живёт ТОЛЬКО на сервере: уходит в Keycloak при обмене
# code на токены. В браузер не попадает никогда — именно поэтому
# OIDC-вход невозможен в чистом SPA.
CYBRA_OIDC_CLIENT_SECRET=cybra-local-dev-secret-not-for-production

# Полный внешний адрес callback. Keycloak сверяет его с белым списком
# клиента символ в символ.
CYBRA_OIDC_REDIRECT_URI=http://localhost:8011/api/v1/auth/oidc/callback

# Куда вернуть человека после входа. Только относительный путь.
CYBRA_OIDC_POST_LOGIN=/

# Роль при первом входе через SSO. Минимальная: промах в настройках
# Keycloak не должен давать админку.
CYBRA_OIDC_DEFAULT_ROLE=viewer

# Разрешать ли локальный пароль при включённом SSO.
# 1 — да (аварийный вход админа, удобно на стенде).
# 0 — корпоративный режим: пришедшие через SSO по паролю не входят.
CYBRA_OIDC_ALLOW_LOCAL=1
