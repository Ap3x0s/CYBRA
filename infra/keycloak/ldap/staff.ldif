# Начальное содержимое каталога: люди и группы.
#
# osixia/openldap читает файлы из /container/service/slapd/assets/config/bootstrap/ldif/custom
# при старте с --copy-service. Здесь создаём подразделения и двух человек.
#
# Зачем это нужно: Keycloak не хранит сотрудников сам, он читает их отсюда.
# Без этих записей LDAP-федерация подключается к пустому каталогу, и вход
# через SSO не с кем проверить.

# --- Структурные подразделения ---------------------------------------
dn: ou=people,dc=example,dc=org
objectClass: organizationalUnit
objectClass: top
ou: people
description: Сотрудники

dn: ou=groups,dc=example,dc=org
objectClass: organizationalUnit
objectClass: top
ou: groups
description: Группы

# --- Сотрудники -------------------------------------------------------
#
# userPassword хранится в открытом виде в файле, но OpenLDAP хеширует его
# при загрузке. Для стенда допустимо; в проде пароли в LDIF не пишут —
# их либо синхронизируют из AD, либо задают через админку.
#
# Пароль у обоих — "password": так проще проверять, и это очевидно
# тестовое значение.

dn: uid=ivanov,ou=people,dc=example,dc=org
objectClass: inetOrgPerson
objectClass: organizationalPerson
objectClass: person
objectClass: top
uid: ivanov
cn: Иван Иванов
sn: Иванов
givenName: Иван
mail: ivanov@example.org
userPassword: password
title: Инженер по безопасности

dn: uid=petrova,ou=people,dc=example,dc=org
objectClass: inetOrgPerson
objectClass: organizationalPerson
objectClass: person
objectClass: top
uid: petrova
cn: Анна Петрова
sn: Петрова
givenName: Анна
mail: petrova@example.org
userPassword: password
title: Аналитик

# --- Группы ролей ------------------------------------------------------
#
# Членство в группе каталога управляет ролью в CYBRA. Сопоставление
# «группа → роль» задаётся в приложении:
#
#   CYBRA_OIDC_GROUP_ROLES=cybra-admins=admin,cybra-operators=operator
#
# Почему роль не берётся из токена напрямую: роли в токене выпускает
# провайдер, и кто может выпустить токен для нашего клиента — получил бы
# админку. Группы отличаются тем, что их состав ведёт администратор
# каталога, а это ровно тот человек, которому мы и хотим доверить
# управление ролями.
#
# Правило синхронизации: каталог управляет ТОЛЬКО теми, кто пришёл из
# каталога. Локальные учётки (включая аварийного админа) неприкосновенны,
# и последнего админа понизить нельзя даже через каталог.

dn: cn=cybra-admins,ou=groups,dc=example,dc=org
objectClass: groupOfNames
objectClass: top
cn: cybra-admins
description: Администраторы консоли CYBRA
member: uid=petrova,ou=people,dc=example,dc=org

dn: cn=cybra-operators,ou=groups,dc=example,dc=org
objectClass: groupOfNames
objectClass: top
cn: cybra-operators
description: Операторы: запускают прогоны и правят датасеты
member: uid=ivanov,ou=people,dc=example,dc=org

# Группа «просто пользователи» — наблюдатели. Оставлена для полноты: так
# видно, что понижение тоже работает, а не только повышение.

dn: cn=cybra-users,ou=groups,dc=example,dc=org
objectClass: groupOfNames
objectClass: top
cn: cybra-users
description: Наблюдатели консоли CYBRA
member: uid=petrova,ou=people,dc=example,dc=org
