# Шаблон переменных фронтенда. Рендерится Ansible в frontend.env.
#
# У nginx нет собственных настроек приложения — всё поведение задано в
# nginx.conf образа. Здесь лежит только то, что действительно меняется от
# окружения к окружению.
#
# Секретов нет и быть не может: фронтенд работает в браузере, любой его
# «секрет» уже опубликован.

# Окружение: dev | stage | prod-lab. Попадает в заголовок ответа, чтобы по
# curl было видно, какой стенд ответил — иначе dev и stage неотличимы.
CYBRA_ENV={{ cybra_env }}

# Порт, который compose публикует наружу. Внутри контейнера nginx всегда
# слушает 8080; меняется только внешний.
FRONTEND_PORT={{ frontend_port }}

# Адрес бэкенда для прокси. Обычно имя сервиса в compose-сети, но в
# prod-lab бэкенд может оказаться на другой машине — тогда здесь полный
# URL. Пустое значение недопустимо: nginx не стартует с битым proxy_pass.
BACKEND_UPSTREAM={{ backend_upstream }}
