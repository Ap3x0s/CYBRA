# Шаблон переменных бэкенда. Рендерится Ansible (template) из
# configurations/environments/<env>.yml в backend.env рядом с compose.yaml.
#
# Правила этого файла:
#   * секретов здесь нет — они приходят из CI-переменных и подставляются
#     отдельно, потому что .env.j2 лежит в Git и его читает любой;
#   * значения проверяются ролью preflight ДО записи: неопределённая
#     переменная должна остановить деплой, а не превратиться в пустую
#     строку в работающем контейнере;
#   * режим файла после записи — 0600.

# Окружение, в котором работает сервис: dev | stage | prod-lab.
# Используется в логах и в подписи отчётов.
CYBRA_ENV={{ cybra_env }}

# Ключ шифрования секретов эндпоинтов (Fernet). Потеря делает сохранённые
# API-ключи нерасшифровываемыми, поэтому он живёт в защищённой переменной CI,
# а не здесь.
CYBRA_SECRET_KEY={{ cybra_secret_key }}

# Адрес и порт внутри контейнера. Менять не нужно: наружу смотрит nginx.
CYBRA_HOST=0.0.0.0
CYBRA_PORT=8000

# Каталог состояния: база (если SQLite), артефакты прогонов, запасной ключ.
CYBRA_DATA_DIR=/data

# Строка подключения. Пусто — приложение работает на SQLite в томе.
CYBRA_DATABASE_URL={{ cybra_database_url }}

# Cookie только по HTTPS. В dev и stage обычно 0, в prod-lab — 1.
CYBRA_COOKIE_SECURE={{ cybra_cookie_secure }}

# Движок прогонов: subprocess (настоящие бенчмарки) или mock (демо).
CYBRA_ENGINE=subprocess

# Время жизни сессии в часах.
CYBRA_SESSION_TTL_HOURS={{ cybra_session_ttl_hours }}

# Самостоятельная регистрация: выключена во всех окружениях.
CYBRA_ALLOW_REGISTRATION=0

# Уровень логирования uvicorn.
LOG_LEVEL={{ cybra_log_level }}
