# Переменные для infra/compose.yaml.
#
# Скопируйте в infra/.env и заполните. Сам .env в .gitignore: здесь секреты.
#
#   cp infra/.env.example infra/.env
#   cd infra && docker compose --env-file .env -f compose.yaml up -d
#
# На настоящем стенде этот файл не правится руками: его рендерит Ansible
# из infra/configurations/ по манифесту релиза, где образы зафиксированы
# по digest. Ручное заполнение — для локальной проверки.

# --- Образы ------------------------------------------------------------
#
# Оба ОБЯЗАТЕЛЬНЫ. Без них compose падает с «BACKEND_IMAGE is required»:
# пустая строка означала бы запуск неизвестно чего.
#
# Здесь тег, потому что локально мы собираем сами. На стенде подставляется
# digest — его нельзя переставить на другой образ, в отличие от тега.
BACKEND_IMAGE=ap3x0/cybra-backend:latest
FRONTEND_IMAGE=ap3x0/cybra-frontend:latest

# Порт, который публикует фронтенд. Единственный открытый наружу.
FRONTEND_PORT=8080

# --- База данных -------------------------------------------------------
#
# По умолчанию строка не задана, и приложение работает на SQLite в томе
# cybra-data. Для одного администратора этого достаточно, и первый запуск
# не требует второго сервиса.
#
# Для PostgreSQL раскомментируйте строку и поднимите профиль db:
#   cd infra && docker compose --env-file .env -f compose.yaml --profile db up -d
# Хост `db` — имя сервиса внутри сети compose.
# CYBRA_DATABASE_URL=postgresql+psycopg://cybra:CHANGE_ME@db:5432/cybra

# Пароль базы. Нужен только с профилем db.
# POSTGRES_PASSWORD=
# POSTGRES_USER=cybra
# POSTGRES_DB=cybra

# --- Приложение --------------------------------------------------------
#
# Ключ шифрования секретов эндпоинтов (Fernet). Сгенерируйте один раз и не
# меняйте: при смене сохранённые API-ключи перестанут расшифровываться.
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# Внимание: этот ключ передаётся НЕ здесь, а в backend.env — см.
# infra/configurations/templates/backend.env.j2. Compose читает только
# .env, а переменные приложения приходят через env_file.

# 1 — приложение стоит за HTTPS-прокси, и cookie сессии уходит только по
# защищённому каналу. Для локального стенда оставьте 0.
# CYBRA_COOKIE_SECURE=0

# Движок прогонов: subprocess (настоящие бенчмарки) или mock (демо).
# CYBRA_ENGINE=subprocess

# Время жизни сессии в часах.
# CYBRA_SESSION_TTL_HOURS=12

# --- Вход через корпоративный аккаунт (OIDC) ---------------------------
#
# Пусто = SSO выключен: кнопки на странице входа нет, приложение работает
# на локальном пароле. Keycloak в наши образы НЕ входит — это сервис
# заказчика, и связь с ним состоит ровно из этих четырёх строк.
#
# Подробности: docs/SSO.md. Тестовый стенд: infra/keycloak/.
# CYBRA_OIDC_ISSUER=https://keycloak.company.ru/realms/corp
# CYBRA_OIDC_CLIENT_ID=cybra
# CYBRA_OIDC_CLIENT_SECRET=
# CYBRA_OIDC_REDIRECT_URI=https://cybra.company.ru/api/v1/auth/oidc/callback
