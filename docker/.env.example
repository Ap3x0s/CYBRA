# Переменные для docker/compose.prod.yaml.
#
# Скопируйте в docker/.env и заполните. Файл в .gitignore: здесь секреты.
#
#   cp docker/.env.example docker/.env
#   docker compose -f docker/compose.prod.yaml up -d

# Обязательно. Ключ шифрования секретов эндпоинтов (Fernet).
# Сгенерируйте один раз и не меняйте: при смене сохранённые API-ключи
# перестанут расшифровываться, и их придётся вводить заново.
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CYBRA_SECRET_KEY=

# Образ. По умолчанию официальный; замените на свой registry при
# корпоративной установке.
# CYBRA_IMAGE=ap3x0/cybra:latest

# --- База данных ------------------------------------------------------
#
# По умолчанию строка не задана, и приложение работает на SQLite в томе
# cybra-data. Для одного администратора этого достаточно, и первый запуск
# не требует второго сервиса.
#
# Для PostgreSQL раскомментируйте строку ниже и поднимите базу профилем db:
#   docker compose -f docker/compose.prod.yaml --profile db up -d
# Хост `db` — имя сервиса внутри сети compose.
#
# CYBRA_DATABASE_URL=postgresql+psycopg://cybra:CHANGE_ME@db:5432/cybra

# Пароль базы. Нужен только с профилем db.
# POSTGRES_PASSWORD=
# POSTGRES_USER=cybra
# POSTGRES_DB=cybra

# --- Поведение --------------------------------------------------------

# Включите 1, когда приложение стоит за HTTPS-прокси: cookie сессии
# перестанут уходить по открытому HTTP.
# CYBRA_COOKIE_SECURE=0

# Движок прогонов: subprocess (настоящие бенчмарки) или mock (демо).
# CYBRA_ENGINE=subprocess

# Время жизни сессии в часах.
# CYBRA_SESSION_TTL_HOURS=12
